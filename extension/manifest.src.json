{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_desc__",
  "version": "1.1.0",
  "default_locale": "en",
  "homepage_url": "https://70015.net",
  "permissions": ["activeTab", "scripting", "unlimitedStorage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "commands": {
    "capture-visible": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "__MSG_cmd_visible__" },
    "capture-full": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "__MSG_cmd_full__" },
    "capture-selection": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "__MSG_cmd_selection__" }
  }
}
